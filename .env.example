# =============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO TIKTOK COMMENTS SCRAPER PRO
# =============================================================================

# 1. SUPABASE DATABASE CONFIG
# Lấy tại: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# 2. GOOGLE OAUTH 2.0 CONFIG
# Lấy tại: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. WEB SERVER CONFIG
PORT=5000
SECRET_KEY=tiktok_scraper_secret_key_2026_super_secure

# 4. PROXY CONFIG (Tùy chọn - chỉ dùng khi cần xoay IP cào số lượng cực lớn)
PROXY_ENABLED=false
PROXY_HOST=
PROXY_USER=
PROXY_PASS=
