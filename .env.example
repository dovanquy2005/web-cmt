SUPABASE_KEY=your-supabase-anon-key-here

# 2. GOOGLE OAUTH 2.0 CONFIG
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. WEB SERVER CONFIG
PORT=5000
